{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lekka.example/schema/rezeptkarte-1.json",
  "title": "rezeptkarte/1",
  "type": "object",
  "required": [
    "schema",
    "title",
    "step"
  ],
  "properties": {
    "schema": {
      "const": "rezeptkarte/1"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{8,}$"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "yield": {
      "type": "string"
    },
    "meta": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "prep": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "step": {
      "$ref": "#/$defs/step"
    }
  },
  "$defs": {
    "step": {
      "type": "object",
      "required": [
        "do",
        "in"
      ],
      "properties": {
        "do": {
          "type": "string",
          "minLength": 1
        },
        "note": {
          "type": "string"
        },
        "in": {
          "type": "array",
          "minItems": 1,
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/step"
              },
              {
                "$ref": "#/$defs/ingredient"
              }
            ]
          }
        }
      }
    },
    "ingredient": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "required": [
            "name"
          ],
          "properties": {
            "amount": {
              "anyOf": [
                {
                  "type": [
                    "number",
                    "null",
                    "string"
                  ]
                },
                {
                  "type": "object",
                  "required": [
                    "von",
                    "bis"
                  ],
                  "properties": {
                    "von": {
                      "type": "number"
                    },
                    "bis": {
                      "type": "number"
                    }
                  }
                }
              ]
            },
            "unit": {
              "type": "string"
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "qual": {
              "type": "string"
            }
          }
        }
      ]
    }
  }
}
