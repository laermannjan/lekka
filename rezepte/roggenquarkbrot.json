{
  "schema": "rezeptkarte/1",
  "title": "Roggenquarkbrot",
  "yield": "1 Kastenbrot",
  "meta": [
    "Vorteig und Brühstück am Vorabend",
    "Roggen-Variante des Dinkelquarkbrots, Salzsauerführung"
  ],
  "prep": [
    "Salz gesamt 12 g, davon 5 g im Vorteig"
  ],
  "step": {
    "do": "auskühlen lassen 24 h",
    "note": "vor dem Anschnitt, sonst bleibt die Krume klitschig",
    "in": [
      {
        "do": "backen 250 °C 15 min, dann fallend 190 °C",
        "note": "vorgeheizt, gesamt 70–80 min, Kerntemperatur 96–98 °C",
        "in": [
          {
            "do": "gehen lassen 60–90 min",
            "note": "bis die Oberfläche aufreißt",
            "in": [
              {
                "do": "in Form geben",
                "note": "glattstreichen, Oberfläche mit nasser Hand",
                "in": [
                  {
                    "do": "gehen lassen 20–30 min",
                    "in": [
                      {
                        "do": "vermengen",
                        "note": "von Hand, Zielteigtemperatur 28–30 °C. Wasser zuletzt und nach Konsistenz, 40–60 g",
                        "in": [
                          {
                            "do": "ruhen lassen 12–16 h",
                            "note": "Vorteig bei 20–22 °C, reif riecht milchig-säuerlich, nicht stechend. Brühstück abgedeckt, vollständig abkühlen lassen",
                            "in": [
                              {
                                "do": "verrühren",
                                "in": [
                                  "Roggenvollkornmehl: 240 g",
                                  "Wasser (ca. 35 °C): 240 g",
                                  "Anstellgut (reif): 50 g",
                                  "Salz: 5 g"
                                ],
                                "note": "Ansatztemperatur 26–28 °C"
                              },
                              {
                                "do": "übergießen",
                                "in": [
                                  "Roggenschrot (grob): 300 g",
                                  "Wasser (kochend): 300 g"
                                ]
                              }
                            ]
                          },
                          "Körner (z. B. Sonnenblumen): 100 g",
                          "Roggenvollkornmehl: 60 g",
                          "Wasser (ca. 30 °C): 50 g",
                          "Magerquark: 75 g",
                          "Salz: 7 g",
                          "Honig: 1 TL"
                        ]
                      }
                    ]
                  },
                  {
                    "do": "einfetten, ausstreuen",
                    "note": "Kastenform 30 cm",
                    "in": [
                      "Haferflocken (grob)"
                    ]
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  }
}
